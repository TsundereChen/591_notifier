# 591 爬蟲設定。
#
# database：SQLite 資料庫路徑（預設為 listings.db）。
# crawl：   要爬取的縣市清單。每一筆都必須包含 region（縣市）；
#           sections（鄉鎮市區）可省略，省略時代表整個縣市；
#           kinds 與 price 也可省略，省略時代表不限類型／租金。
#           exclude_keywords 可填寫要排除的關鍵字；不分大小寫，命中時標記為已篩選，
#           後續執行會重新比對，移除排除條件後可恢復通知。
# 機器人固定檢查前 5 頁，且每次執行時每個縣市最多處理 150 筆結果。

database: listings.db
schedule: "*/15 * * * *"
timezone: Asia/Taipei

# TELEGRAM_ALLOWED_USER_ID 指定的使用者在私聊傳送 /start 後，機器人會填入
# 下列綁定資料。通知聊天室一旦綁定便不會因其他聊天室的操作而自動變更。
telegram:
  owner_user_id:
  chat_id:

# AI 物件評估（預設停用）。啟用後，會先讀取物件詳情與照片，再使用
# OpenAI Chat Completions 相容模型給出推薦與理由。API 端點、API 金鑰與至少一個模型都設定後才會執行；
# 缺少任一項時會略過 AI 評估，物件仍會正常通知。API key 只從本設定讀取並保存在此檔案。
ai:
  enabled: false
  filter: true # true：不通知 AI 不推薦的物件；false：仍通知，但附上 AI 評語。
  # API 基礎 URL 或完整的 /chat/completions URL；不可包含登入資訊、查詢字串或 fragment。
  # 建議使用 HTTPS；HTTP 會以明文傳送 API key、物件文字與照片。
  api_endpoint: # 例如：https://api.openai.com/v1
  api_key: # 必填；直接編輯 YAML 時請用引號包住金鑰。
  # 依序嘗試模型；每個模型在單次爬蟲累積失敗五次後停用，下一次爬蟲會重新計算。
  # 分析照片時請選擇支援 image input 的模型。
  models: [] # 例如：[gpt-4o-mini, openai/gpt-4o]
  criteria: # 可填寫自訂偏好；留空時使用預設的租金、屋況、採光與紅旗評估。
  max_images: 6

crawl:
  - region: 新北市
    sections:
      - 土城區
      - 中和區
    kinds: []  # 例如：[整層住家, 獨立套房]；空陣列代表不限類型。
    price: {}  # 例如：{min: 10000, max: 30000}；空物件代表不限租金。
    exclude_keywords: [] # 例如：[頂樓加蓋, 雅房]；命中任一關鍵字就不通知。
  - region: 台北市
    sections: []
    kinds: []
    price: {}
    exclude_keywords: []
